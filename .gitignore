# 仓库只放代码、命令、数据与可复现所需的元数据。
# 工作文档（docs/、AGENTS.md、任何 docx/zip）与内部规则（.codebuddy/）不外传。

# 凭证与隐私
secrets/
*.pem
*.key

# 工作文档与内部资料
docs/
AGENTS.md
.codebuddy/
*.docx
*.zip

# 环境与第三方材料
.venv/
archive/
dist/
datasets/

# 数据集副本
work/ProToDFL/data/
work/ProToDFL/datacifar10/

# 训练产物：模型快照、控制台日志、运行日志
work/ProToDFL/outputs/checkpoints/
work/ProToDFL/outputs/console/
work/ProToDFL/outputs/logs/
work/ProToDFL/outputs/experiments/**/checkpoints/
*.log

# 一次性脚本与工作文档副本
work/ProToDFL/scripts/_oneoff/
work/ProToDFL/docs_src/

# 文档生成器（产出的是工作文档，脚本本身也不外传）
work/ProToDFL/scripts/build_*_docx.py
work/ProToDFL/scripts/docx_helpers.py
work/ProToDFL/scripts/_sync_reflow_text.py
work/ProToDFL/scripts/verify_weekly_numbers.py

# 监控进程的 stdout/stderr
work/ProToDFL/outputs/watchdog/*.err
work/ProToDFL/outputs/watchdog/*.out

# 打包备份
work/ProToDFL/outputs/*.tar.gz

# 杂项
__pycache__/
*.pyc
.DS_Store

# 含服务器地址的本地运维工具
work/ProToDFL/scripts/rsh.py
work/ProToDFL/scripts/remote_exec.py
work/ProToDFL/scripts/remote_pull.py
